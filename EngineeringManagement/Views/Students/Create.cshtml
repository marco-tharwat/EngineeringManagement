@model EngineeringManagement.Models.Student

@{
    ViewData["Title"] = "Create Student";
}

<h1>Create Student</h1>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="FullName" class="control-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="YearOfStudy" class="control-label"></label>
        <input asp-for="YearOfStudy" class="form-control" />
        <span asp-validation-for="YearOfStudy" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DepartmentId" class="control-label">Department</label>
        <select asp-for="DepartmentId" class="form-control" asp-items="ViewBag.Departments">
            <option value="">-- Select Department --</option>
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>

    <input type="submit" value="Add" class="btn btn-primary mt-5" />
    <a asp-action="Index" class="btn btn-secondary mt-5">Back to List</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}