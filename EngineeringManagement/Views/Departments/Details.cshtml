@model EngineeringManagement.Models.Department

@{
    ViewData["Title"] = "Department Details";
}

<h1>Department Details</h1>

<div>
    <h4>Department</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>
    </dl>
</div>

@if (Model.Professors != null && Model.Professors.Any())
{
    <h4>Professors</h4>
    <ul>
        @foreach (var prof in Model.Professors)
        {
            <li>@prof.FullName</li>
        }
    </ul>
}

@if (Model.Students != null && Model.Students.Any())
{
    <h4>Students</h4>
    <ul>
        @foreach (var student in Model.Students)
        {
            <li>@student.FullName</li>
        }
    </ul>
}

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning">Edit</a> 
</div>
<div>
    <a asp-action="Index" class="btn btn-primary mt-2">Back to List</a>
</div>