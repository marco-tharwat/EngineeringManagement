@model EngineeringManagement.Models.Department

@{
    ViewData["Title"] = "Delete Department";
}

<h1>Delete Department</h1>

<h3 class="alert alert-danger text-center">Are you sure you want to delete this?</h3>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @Html.ValidationSummary(false)
    </div>
}

<div>
    <h4>Department</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        @if (ViewBag.AllStudents > 0)
        {
            <dt class="col-sm-2">
                Students
            </dt>
            <dd class="col-sm-10">
                @ViewBag.AllStudents student(s) associated
            </dd>
        }
        @if (ViewBag.AllProfessors > 0)
        {
            <dt class="col-sm-2">
                Professors
            </dt>
            <dd class="col-sm-10">
                @ViewBag.AllProfessors professor(s) associated
            </dd>
        }
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
    </form>
    <div>
        <a asp-action="Index" class="btn btn-primary mt-2">Cancel</a>
    </div>
</div>